<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.4'>
  <world name='orchard'>
    <physics type='ode'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>


    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
    </scene>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>39.512152</latitude_deg>
      <longitude_deg>22.426669</longitude_deg>
      <elevation>344</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Terreno do Pomar -->
    <model name='orchard'>
      <pose>-10 -10 0 0 0 0</pose>
      <static>true</static>
      <link name='orchard'>
        <collision name='orchard_collision'>
          <geometry>
            <mesh>
              <uri>model://orchard/orchard_world.dae</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='orchard_visual'>
          <geometry>
            <mesh>
              <uri>model://orchard/orchard_world.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ==================== 10 ÁRVORES CILÍNDRICAS (Y = -1.36) ==================== -->
    <model name='arvore_1'>
      <static>true</static>
      <pose>4.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_2'>
      <static>true</static>
      <pose>6.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_3'>
      <static>true</static>
      <pose>8.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_4'>
      <static>true</static>
      <pose>10.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_5'>
      <static>true</static>
      <pose>12.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_6'>
      <static>true</static>
      <pose>14.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_7'>
      <static>true</static>
      <pose>16.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_8'>
      <static>true</static>
      <pose>18.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_9'>
      <static>true</static>
      <pose>20.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name='arvore_10'>
      <static>true</static>
      <pose>22.80 0.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='vis'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.0 0.8 0.1 1</ambient><diffuse>0.0 0.8 0.1 1</diffuse></material></visual>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>2.0</length></cylinder></geometry></collision>
      </link>
    </model>

      <model name="uav"> <!-- drone-->
          <pose> 0 0 2 0 0 0</pose>
        <link name="base_link">
          <gravity>false</gravity>
          <inertial>
            <mass>1.5</mass>
            <inertia>
              <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
              <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
            </inertia>
          </inertial>

          <visual name="body">
            <geometry><box><size>0.30 0.30 0.08</size></box></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
          </visual>
          <collision name="body_col">
            <geometry><box><size>0.30 0.30 0.08</size></box></geometry>
          </collision>

          <!-- Bracos e rotores (apenas visuais) -->
          <visual name="arm_x">
            <geometry><box><size>0.70 0.03 0.02</size></box></geometry>
            <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
          </visual>
          <visual name="arm_y">
            <geometry><box><size>0.03 0.70 0.02</size></box></geometry>
            <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
          </visual>
          <visual name="rotor_1"><pose>0.35 0 0.03 0 0 0</pose>
            <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
            <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
          <visual name="rotor_2"><pose>-0.35 0 0.03 0 0 0</pose>
            <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
            <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material></visual>
          <visual name="rotor_3"><pose>0 0.35 0.03 0 0 0</pose>
            <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
            <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material></visual>
          <visual name="rotor_4"><pose>0 -0.35 0.03 0 0 0</pose>
            <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
            <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material></visual>

          <sensor name="imu" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <topic>uav/imu</topic>
          </sensor>

          <!-- Camara integrada, a apontar para baixo -->
          <sensor name="camera_sensor" type="camera">
            <pose>0 0 -0.06 0 1.5708 0</pose>
            <camera>
              <horizontal_fov>1.047</horizontal_fov>
              <image><width>640</width><height>480</height></image>
              <clip><near>0.1</near><far>100</far></clip>
            </camera>
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw</topic>
          </sensor>
        </link>

        <!-- Controlo por velocidade: recebe Twist em uav/cmd_vel -->
        <plugin filename="gz-sim-velocity-control-system"
                name="gz::sim::systems::VelocityControl">
          <topic>uav/cmd_vel</topic>
        </plugin>

        <plugin filename="gz-sim-odometry-publisher-system"
                name="gz::sim::systems::OdometryPublisher">
          <odom_frame>uav/odom</odom_frame>
          <robot_base_frame>uav/base_link</robot_base_frame>
          <odom_topic>uav/odom</odom_topic>
          <dimensions>3</dimensions>
        </plugin>
  </model>
  </world>
</sdf>
